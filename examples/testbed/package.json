{
  "name": "@plumb/testbed",
  "version": "0.0.0",
  "private": true,
  "description": "Plumb 시험용 Next.js 프로젝트. 도구가 동작하는지 확인하는 용도 (기획안 §15)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "biome check .",
    "test": "prisma generate && vitest run",
    "test:junit": "prisma generate && vitest run --reporter=junit --outputFile=reports/junit.xml",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:json": "depcruise src --config .dependency-cruiser.cjs --output-type json --output-to reports/depcruise.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local": "bash scripts/db-local.sh",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.5.0",
    "fast-check": "^4.10.2",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
